# Production Accounting service runtime only.
# Inject real values through the deployment secret manager; never deploy placeholders.
NODE_ENV=production
HOST=0.0.0.0
PORT=3300

# Use the restricted runtime role; it must not own RLS tables or have BYPASSRLS.
ACCOUNTING_DATABASE_URL=postgresql://ACCOUNTING_RUNTIME_ROLE:REPLACE_WITH_RUNTIME_PASSWORD@POSTGRES_HOST:5432/ACCOUNTING_DATABASE?sslmode=verify-full

# Gateway auth is required when integrated with AfroLife. Keep this service private;
# terminate TLS at the approved internal gateway/load balancer.
ACCOUNTING_AUTH_MODE=gateway
ACCOUNTING_GATEWAY_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Each source gets its own random secret. The afrolife_core value must match
# ACCOUNTING_INGEST_SECRET in the core API deployment.
ACCOUNTING_INGEST_SECRETS={"afrolife_core":"REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"}
