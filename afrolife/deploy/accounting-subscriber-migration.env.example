# Load only in the controlled release job for the subscriber-only database.
# Never reuse the internal Accounting migration owner or database.
ACCOUNTING_MIGRATION_DATABASE_URL=postgresql://ACCOUNTING_SAAS_MIGRATION_OWNER:REPLACE_WITH_SAAS_MIGRATION_PASSWORD@SUBSCRIBER_POSTGRES_HOST:5432/ACCOUNTING_SAAS_DATABASE?sslmode=verify-full
ACCOUNTING_RUNTIME_DB_ROLE=ACCOUNTING_SAAS_RUNTIME_ROLE

# Create the restricted runtime role before applying Accounting migrations.
# Use the same role in ACCOUNTING_DATABASE_URL for the subscriber service.
