NODE_ENV=production
INSURANCE_DATABASE_URL=postgresql://insurance_runtime:REPLACE_WITH_RUNTIME_PASSWORD@127.0.0.1:5432/afrolife_insurance
INSURANCE_GATEWAY_SECRET=REPLACE_WITH_THE_SAME_RANDOM_SECRET_AS_MAIN_API
# Optional Accounting feed. Set both only after entity/account mappings are configured.
ACCOUNTING_SERVICE_URL=
ACCOUNTING_INGEST_SECRET=
# Transitional identity/Insurance-request connection: restricted central runtime role.
AFROLIFE_DATABASE_URL=postgresql://afrolife_app:REPLACE_WITH_RUNTIME_PASSWORD@127.0.0.1:5432/afrolife
