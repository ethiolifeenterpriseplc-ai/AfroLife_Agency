[Unit]
Description=AfroLife Property Management API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=afrolife
Group=afrolife
WorkingDirectory=/opt/afrolife/app
EnvironmentFile=/etc/afrolife/property-management.env
Environment=HOST=127.0.0.1
Environment=PORT=3402
ExecStart=/usr/bin/node /opt/afrolife/app/dist/services/property-management/server.js
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/afrolife/private-files

[Install]
WantedBy=multi-user.target
