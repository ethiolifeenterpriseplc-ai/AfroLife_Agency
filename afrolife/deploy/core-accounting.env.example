# AfroLife core -> private Accounting service connection.
# Inject both secrets from the deployment secret manager; never deploy placeholders.
ACCOUNTING_SERVICE_URL=https://ACCOUNTING_PRIVATE_SERVICE_HOST
ACCOUNTING_GATEWAY_SECRET=REPLACE_WITH_THE_SAME_RANDOM_SECRET_AS_ACCOUNTING_SERVICE
ACCOUNTING_INGEST_SECRET=REPLACE_WITH_THE_SAME_SECRET_AS_AFROLIFE_CORE_INGEST_MAPPING

# Separate subscriber Accounting instance: separate hostname, database, and secret.
# Subscriber customer/property-owner requests route here; corporate finance routes above.
ACCOUNTING_SUBSCRIBER_SERVICE_URL=https://ACCOUNTING_SUBSCRIBER_SERVICE_HOST
ACCOUNTING_SUBSCRIBER_GATEWAY_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_FOR_SUBSCRIBER_ACCOUNTING

# Public service subscriptions remain unavailable for Finance confirmation until
# these codes map to an active Accounting entity and its source-account mappings.
SUBSCRIPTION_ACCOUNTING_SOURCE_ENTITY_ID=
SUBSCRIPTION_ACCOUNTING_CASH_ACCOUNT_CODE=
SUBSCRIPTION_ACCOUNTING_REVENUE_ACCOUNT_CODE=

# The ingest secret above must be identical to the afrolife_core value in
# ACCOUNTING_INGEST_SECRETS on the Accounting service. Do not reuse the gateway
# secret as an ingest secret.
