# AfroLife core -> private Accounting service connection.
# Inject both secrets from the deployment secret manager; never deploy placeholders.
ACCOUNTING_SERVICE_URL=https://ACCOUNTING_PRIVATE_SERVICE_HOST
ACCOUNTING_GATEWAY_SECRET=REPLACE_WITH_THE_SAME_RANDOM_SECRET_AS_ACCOUNTING_SERVICE
ACCOUNTING_INGEST_SECRET=REPLACE_WITH_THE_SAME_SECRET_AS_AFROLIFE_CORE_INGEST_MAPPING

# The ingest secret above must be identical to the afrolife_core value in
# ACCOUNTING_INGEST_SECRETS on the Accounting service. Do not reuse the gateway
# secret as an ingest secret.
