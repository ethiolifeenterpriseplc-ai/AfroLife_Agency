# Subscriber-facing Accounting & Finance service runtime only.
# Provision a dedicated database and hostname; do not reuse the internal books database.
NODE_ENV=production
HOST=0.0.0.0
PORT=3302

# Restricted runtime role on the subscriber-only Accounting database.
ACCOUNTING_DATABASE_URL=postgresql://ACCOUNTING_SAAS_RUNTIME_ROLE:REPLACE_WITH_RUNTIME_PASSWORD@SUBSCRIBER_POSTGRES_HOST:5432/ACCOUNTING_SAAS_DATABASE?sslmode=verify-full

# Keep this separate from the internal Accounting gateway secret.
ACCOUNTING_AUTH_MODE=gateway
ACCOUNTING_GATEWAY_SECRET=REPLACE_WITH_THE_RANDOM_SECRET_MATCHING_ACCOUNTING_SUBSCRIBER_GATEWAY_SECRET

# Source integration is opt-in. Do not point subscriber events at internal books.
ACCOUNTING_INGEST_SECRETS={}
