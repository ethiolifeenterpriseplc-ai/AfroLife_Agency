# Load only in the controlled schema-migration release job, never in the
# Accounting application container or long-running service environment.
ACCOUNTING_MIGRATION_DATABASE_URL=postgresql://ACCOUNTING_MIGRATION_OWNER:REPLACE_WITH_MIGRATION_PASSWORD@POSTGRES_HOST:5432/ACCOUNTING_DATABASE?sslmode=verify-full
ACCOUNTING_RUNTIME_DB_ROLE=ACCOUNTING_RUNTIME_ROLE

# Create this restricted, non-owner, non-superuser role before running the job.
# The migrator grants table/function permissions to it; use the same role in
# ACCOUNTING_DATABASE_URL for the Accounting application runtime.
