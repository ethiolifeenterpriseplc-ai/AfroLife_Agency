# Private SACCO/MFI backend; bind only to loopback.
NODE_ENV=production
HOST=127.0.0.1
PORT=3300
# Transitional service split: use the same restricted database and private file
# store as the current API until an independently reconciled MFI schema exists.
MFI_DATABASE_URL=postgresql://afrolife_app:REPLACE_WITH_RUNTIME_PASSWORD@127.0.0.1:5432/afrolife
MFI_GATEWAY_SECRET=REPLACE_WITH_THE_SAME_RANDOM_SECRET_AS_MAIN_API
FILE_STORAGE_DIR=C:/ProgramData/AfroLife/private-files
