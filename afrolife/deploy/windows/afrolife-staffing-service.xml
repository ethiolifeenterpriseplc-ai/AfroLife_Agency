<service>
  <id>AfroLifeStaffing</id>
  <name>AfroLife Staffing Service</name>
  <description>Private staffing request and matching backend behind the AfroLife Super App gateway</description>
  <executable>C:\Program Files\nodejs\node.exe</executable>
  <arguments>C:\AfroLife\app\dist\services\staffing\server.js</arguments>
  <workingdirectory>C:\AfroLife\app</workingdirectory>
  <env name="AFROLIFE_ENV_FILE" value="C:\ProgramData\AfroLife\staffing.env" />
  <env name="HOST" value="127.0.0.1" />
  <env name="PORT" value="3401" />
  <logpath>C:\ProgramData\AfroLife\logs\staffing</logpath>
  <log mode="roll" />
  <stoptimeout>30 sec</stoptimeout>
  <onfailure action="restart" delay="10 sec" />
</service>
