<service>
  <id>AfroLifeEdir</id>
  <name>AfroLife Edir Service</name>
  <description>Private Edir backend behind the AfroLife Super App gateway</description>
  <executable>C:\Program Files\nodejs\node.exe</executable>
  <arguments>C:\AfroLife\app\dist\services\afrolife-edir\server.js</arguments>
  <workingdirectory>C:\AfroLife\app</workingdirectory>
  <env name="AFROLIFE_ENV_FILE" value="C:\ProgramData\AfroLife\edir.env" />
  <env name="HOST" value="127.0.0.1" />
  <env name="PORT" value="3200" />
  <logpath>C:\ProgramData\AfroLife\logs\edir</logpath>
  <log mode="roll" />
  <stoptimeout>30 sec</stoptimeout>
  <onfailure action="restart" delay="10 sec" />
</service>
