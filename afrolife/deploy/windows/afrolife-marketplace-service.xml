<service>
  <id>AfroLifeMarketplace</id>
  <name>AfroLife Marketplace Service</name>
  <description>Private marketplace backend behind the AfroLife Super App gateway</description>
  <executable>C:\Program Files\nodejs\node.exe</executable>
  <arguments>C:\AfroLife\app\dist\services\marketplace\server.js</arguments>
  <workingdirectory>C:\AfroLife\app</workingdirectory>
  <env name="AFROLIFE_ENV_FILE" value="C:\ProgramData\AfroLife\marketplace.env" />
  <env name="HOST" value="127.0.0.1" />
  <env name="PORT" value="3403" />
  <logpath>C:\ProgramData\AfroLife\logs\marketplace</logpath>
  <log mode="roll" />
  <stoptimeout>30 sec</stoptimeout>
  <onfailure action="restart" delay="10 sec" />
</service>
