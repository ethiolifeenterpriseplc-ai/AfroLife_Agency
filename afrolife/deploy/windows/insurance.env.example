# Private AfroLife Insurance Ledger backend; bind only to loopback.
NODE_ENV=production
HOST=127.0.0.1
PORT=3100
INSURANCE_DATABASE_URL=postgres://afrolife_insurance_app:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/afrolife_insurance
INSURANCE_GATEWAY_SECRET=REPLACE_WITH_THE_SAME_RANDOM_SECRET_AS_MAIN_API
# Transitional Insurance-request connection. Use the same restricted central runtime account.
AFROLIFE_DATABASE_URL=postgres://afrolife_app:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/afrolife
