<service>
  <id>AfroLifeInsuranceLedger</id>
  <name>AfroLife Insurance Ledger Service</name>
  <description>Private insurance ledger backend behind the AfroLife Super App gateway</description>
  <executable>C:\Program Files\nodejs\node.exe</executable>
  <arguments>C:\AfroLife\app\dist\services\insurance-ledger\server.js</arguments>
  <workingdirectory>C:\AfroLife\app</workingdirectory>
  <env name="AFROLIFE_ENV_FILE" value="C:\ProgramData\AfroLife\insurance.env" />
  <env name="HOST" value="127.0.0.1" />
  <env name="PORT" value="3100" />
  <logpath>C:\ProgramData\AfroLife\logs\insurance-ledger</logpath>
  <log mode="roll" />
  <stoptimeout>30 sec</stoptimeout>
  <onfailure action="restart" delay="10 sec" />
</service>
