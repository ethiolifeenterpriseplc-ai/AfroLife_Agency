PORT=3310
# Dedicated Global BI database only; this role must have SELECT privileges and no writes.
GLOBAL_BI_DATABASE_URL=postgres://global_bi_reader:replace-me@127.0.0.1:5432/afrolife_global_bi
# Gateway secret must match GLOBAL_BI_GATEWAY_SECRET in the central AfroLife API.
GLOBAL_BI_GATEWAY_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
# Used only for controlled schema setup:
GLOBAL_BI_MIGRATION_DATABASE_URL=postgres://global_bi_migrator:replace-me@127.0.0.1:5432/afrolife_global_bi
# Used only by a future trusted 30-minute projector/import job; not configured on the query service.
GLOBAL_BI_INGEST_DATABASE_URL=postgres://global_bi_projector:replace-me@127.0.0.1:5432/afrolife_global_bi
# Set only in a tenant-bound 30-minute projector deployment, not in the query service.
GLOBAL_BI_PROJECTOR_TENANT_ID=
