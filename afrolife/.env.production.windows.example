NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Use the restricted runtime database role, never the migration owner.
# URL-encode special characters in the password. If the database is remote,
# use sslmode=verify-full and install/configure its trusted CA certificate.
DATABASE_URL=postgres://afrolife_app:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/afrolife

JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
MFA_ENC_KEY=REPLACE_WITH_A_DIFFERENT_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
REQUIRE_MFA_FOR_STAFF=1
MFI_PILOT_ENABLED=1
SESSION_IDLE_TIMEOUT_MINUTES=30

FILE_STORAGE_DIR=C:/ProgramData/AfroLife/private-files
CORS_ORIGINS=https://afrolife-agency.duckdns.org,https://localhost
TRUST_PROXY=1
LOGIN_RATE_LIMIT=20

# Private backends; the public IIS site sends all requests to the main API gateway.
EDIR_SERVICE_URL=http://127.0.0.1:3200
EDIR_GATEWAY_SECRET=REPLACE_WITH_THE_SAME_RANDOM_SECRET_AS_EDIR_SERVICE
# Enable after the MFI backend service is deployed and its route smoke tests pass.
MFI_SERVICE_URL=http://127.0.0.1:3300
MFI_GATEWAY_SECRET=REPLACE_WITH_THE_SAME_RANDOM_SECRET_AS_MFI_SERVICE
# The production API refuses the legacy in-process Insurance ledger.
# Set readiness only after service migration, reconciliation and rollback review.
INSURANCE_SERVICE_URL=http://127.0.0.1:3100
INSURANCE_GATEWAY_SECRET=REPLACE_WITH_THE_SAME_RANDOM_SECRET_AS_INSURANCE_SERVICE
INSURANCE_SERVICE_CUTOVER_READY=0
# Configure each corresponding service with its own restricted database login
# and the same private file store where that domain reads/writes private media.
WORKER_MANAGEMENT_SERVICE_URL=http://127.0.0.1:3400
WORKER_MANAGEMENT_GATEWAY_SECRET=REPLACE_WITH_THE_SAME_RANDOM_SECRET_AS_WORKER_MANAGEMENT_SERVICE
STAFFING_SERVICE_URL=http://127.0.0.1:3401
STAFFING_GATEWAY_SECRET=REPLACE_WITH_THE_SAME_RANDOM_SECRET_AS_STAFFING_SERVICE
PROPERTY_MANAGEMENT_SERVICE_URL=http://127.0.0.1:3402
PROPERTY_MANAGEMENT_GATEWAY_SECRET=REPLACE_WITH_THE_SAME_RANDOM_SECRET_AS_PROPERTY_MANAGEMENT_SERVICE
MARKETPLACE_SERVICE_URL=http://127.0.0.1:3403
MARKETPLACE_GATEWAY_SECRET=REPLACE_WITH_THE_SAME_RANDOM_SECRET_AS_MARKETPLACE_SERVICE
