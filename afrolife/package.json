{
  "name": "afrolife-agency",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "build:insurance": "tsc -p services/insurance-ledger/tsconfig.json",
    "build:accounting": "tsc -p services/accounting/tsconfig.json && node scripts/copy-accounting-assets.mjs",
    "build:global-bi": "tsc -p services/global-bi/tsconfig.json",
    "build:edir": "tsc -p services/afrolife-edir/tsconfig.json",
    "build:mfi": "tsc -p services/sacco-mfi/tsconfig.json",
    "build:workforce-management": "tsc -p services/workforce-management/tsconfig.json",
    "build:worker-management": "npm run build:workforce-management",
    "build:staffing": "tsc -p services/staffing/tsconfig.json",
    "build:property-management": "tsc -p services/property-management/tsconfig.json",
    "build:marketplace": "tsc -p services/marketplace/tsconfig.json",
    "build:agency-domains": "npm run build:workforce-management && npm run build:staffing && npm run build:property-management && npm run build:marketplace",
    "start": "node dist/src/server.js",
    "start:insurance": "node dist/services/insurance-ledger/server.js",
    "start:accounting": "node dist/services/accounting/server.js",
    "start:global-bi": "node dist/services/global-bi/server.js",
    "start:edir": "node dist/services/afrolife-edir/server.js",
    "start:mfi": "node dist/services/sacco-mfi/server.js",
    "start:workforce-management": "node dist/services/workforce-management/server.js",
    "start:worker-management": "npm run start:workforce-management",
    "start:staffing": "node dist/services/staffing/server.js",
    "start:property-management": "node dist/services/property-management/server.js",
    "start:marketplace": "node dist/services/marketplace/server.js",
    "db:local:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-database.ps1 -Action Setup",
    "db:local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-database.ps1 -Action Start",
    "db:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-database.ps1 -Action Stop",
    "db:local:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-database.ps1 -Action Status",
    "db:agency-domains:local:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/provision-local-agency-domains.ps1",
    "db:agency-domains:local:harden": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/harden-local-agency-domain-roles.ps1",
    "migrate:agency-domains:uat:dry-run": "node scripts/migrate-agency-domains-uat.mjs --dry-run",
    "migrate:agency-domains:uat": "node scripts/migrate-agency-domains-uat.mjs",
    "check:local-deployment": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-local-deployment.ps1",
    "db:insurance:local:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/provision-local-insurance.ps1",
    "db:edir:local:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/provision-local-edir.ps1",
    "android:add": "cap add android",
    "android:branding": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-android-brand-assets.ps1",
    "android:sync": "npm run android:branding && cap sync android",
    "android:open": "cap open android",
    "android:build": "npm run android:branding && cap sync android && cd android && .\\gradlew.bat --project-cache-dir \"%LOCALAPPDATA%\\AfroLife\\gradle-project-cache\" --init-script gradle\\build-output.init.gradle assembleDebug",
    "android:release": "npm run android:branding && cap sync android && cd android && .\\gradlew.bat --project-cache-dir \"%LOCALAPPDATA%\\AfroLife\\gradle-project-cache\" --init-script gradle\\build-output.init.gradle assembleRelease",
    "ios:add": "cap add ios",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios",
    "seed:admin": "tsx src/seed-admin.ts",
    "seed:local-test-users": "tsx scripts/seed-local-test-users.ts",
    "seed:mfi:e2e:local": "node --require ./.codex-osinfo-fallback.cjs --import tsx scripts/seed-local-mfi-e2e-users.ts",
    "db:migrate": "tsx src/migrate.ts",
    "db:check-runtime-acls": "node scripts/check-runtime-acls.mjs",
    "migrate:insurance": "npm run build:insurance && node dist/services/insurance-ledger/migrate.js",
    "migrate:accounting": "npm run build:accounting && node dist/services/accounting/migrate.js",
    "migrate:accounting:apply": "node dist/services/accounting/migrate.js",
    "migrate:global-bi": "tsx services/global-bi/migrate.ts",
    "import:global-bi": "tsx services/global-bi/import-projections.ts",
    "migrate:edir": "npm run build:edir && node dist/services/afrolife-edir/migrate.js",
    "test:unit": "tsx --test test/phone.test.ts test/domain.test.ts test/matching.test.ts test/rent-refunds.test.ts test/security.test.ts test/totp.test.ts test/csv.test.ts test/property-accounting.test.ts test/mfi.test.ts test/mfi-credit.test.ts test/lending-products.test.ts test/insurance-ledger.test.ts test/insurance-brokerage-sandbox.test.ts test/insurance-service-gateway.test.ts test/insurance-service-schema.test.ts test/edir-service-schema.test.ts test/edir-money.test.ts test/edir-credit.test.ts test/auth-role.test.ts test/mini-app-access.test.ts test/api-errors.test.ts test/privacy-access.test.ts test/insurance-global-admin-access.test.ts test/rate-limit-store.test.ts test/runtime-config.test.ts test/mock-provider-config.test.ts test/agency-accounting.test.ts test/accounting-controls.test.ts test/migration-security.test.ts test/service-worker.test.ts test/mini-app-registry.test.ts test/supply-service-boundaries.test.ts test/domain-database-readiness.test.ts test/platform-tenant-control-plane.test.ts test/workspace-shell.test.mjs",
    "test:mfi:e2e:local": "node --require ./.codex-osinfo-fallback.cjs --import tsx scripts/local-mfi-e2e.ts",
    "test:edir:e2e:local": "tsx scripts/local-edir-e2e.ts",
    "test:property-finance:e2e:local": "node --require ./.codex-osinfo-fallback.cjs scripts/local-property-finance-e2e.mjs",
    "test:staffing-accounting:e2e:local": "node --require ./.codex-osinfo-fallback.cjs scripts/local-staffing-accounting-e2e.mjs",
    "test:ui:e2e:local": "node scripts/local-ui-smoke.mjs",
    "perf:v7:local": "node scripts/v7-load-smoke.mjs",
    "verify:property-restore": "node scripts/property-restore-verify.mjs",
    "test:integration": "tsx --test test/api.test.ts test/supply.test.ts",
    "test:finance:e2e:local": "node scripts/run-local-finance-e2e.mjs",
    "test": "npm run test:unit"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.6.9",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
