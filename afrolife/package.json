{
  "name": "afrolife-agency",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "build:insurance": "tsc -p services/insurance-ledger/tsconfig.json",
    "start": "node dist/src/server.js",
    "start:insurance": "node dist/services/insurance-ledger/server.js",
    "db:local:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-database.ps1 -Action Setup",
    "db:local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-database.ps1 -Action Start",
    "db:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-database.ps1 -Action Stop",
    "db:local:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local-database.ps1 -Action Status",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:build": "cap sync android && cd android && .\\gradlew.bat --project-cache-dir \"%LOCALAPPDATA%\\AfroLife\\gradle-project-cache\" --init-script gradle\\build-output.init.gradle assembleDebug",
    "android:release": "cap sync android && cd android && .\\gradlew.bat --project-cache-dir \"%LOCALAPPDATA%\\AfroLife\\gradle-project-cache\" --init-script gradle\\build-output.init.gradle assembleRelease",
    "seed:admin": "tsx src/seed-admin.ts",
    "seed:local-test-users": "tsx scripts/seed-local-test-users.ts",
    "db:migrate": "tsx src/migrate.ts",
    "migrate:insurance": "npm run build:insurance && node dist/services/insurance-ledger/migrate.js",
    "test:unit": "tsx --test test/phone.test.ts test/domain.test.ts test/matching.test.ts test/rent-refunds.test.ts test/security.test.ts test/totp.test.ts test/csv.test.ts test/mfi.test.ts test/mfi-credit.test.ts test/insurance-ledger.test.ts test/insurance-service-gateway.test.ts test/runtime-config.test.ts test/service-worker.test.ts",
    "test:mfi:e2e:local": "tsx scripts/local-mfi-e2e.ts",
    "test:ui:e2e:local": "node scripts/local-ui-smoke.mjs",
    "test:integration": "tsx --test test/api.test.ts test/supply.test.ts",
    "test": "npm run test:unit"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
