NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://afrolife:change-me@localhost:5432/afrolife
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
MFA_ENC_KEY=replace-with-a-different-random-secret-at-least-32-characters
FILE_STORAGE_DIR=./data/private-files
REQUIRE_MFA_FOR_STAFF=0
SESSION_IDLE_TIMEOUT_MINUTES=30
CORS_ORIGINS=https://localhost
# Optional gradual cutover. If unset, insurance requests stay on the existing API.
INSURANCE_SERVICE_URL=
INSURANCE_GATEWAY_SECRET=
# Configure these only in the insurance-ledger service/deployment:
# INSURANCE_DATABASE_URL=postgres://insurance_runtime:...@db:5432/insurance_ledger
# INSURANCE_MIGRATION_DATABASE_URL=postgres://insurance_migrator:...@db:5432/insurance_ledger
# INSURANCE_RUNTIME_DB_ROLE=insurance_runtime
