NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://afrolife:change-me@localhost:5432/afrolife
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
MFA_ENC_KEY=replace-with-a-different-random-secret-at-least-32-characters
FILE_STORAGE_DIR=./data/private-files
REQUIRE_MFA_FOR_STAFF=0
SESSION_IDLE_TIMEOUT_MINUTES=30
# Comma-separated panel IDs to show for this deployment; omit to show all modules.
# Overview, Security, and Admin remain available where the account role permits.
# This controls navigation only; API authorization remains enforced server-side.
AFROLIFE_ENABLED_MODULES=
CORS_ORIGINS=https://localhost
# Private service gateways. Keep these URLs on loopback or a trusted HTTPS network.
EDIR_SERVICE_URL=
EDIR_GATEWAY_SECRET=
# Optional local/development Insurance service gateway. Production requires the separate service and cutover readiness.
INSURANCE_SERVICE_URL=
INSURANCE_GATEWAY_SECRET=
# Optional local/development SACCO/MFI process gateway. Production requires it whenever the pilot is enabled.
MFI_SERVICE_URL=
MFI_GATEWAY_SECRET=
# Optional local/development Agency domain process gateways. In production, configure
# each service URL and its matching 32+ character secret before enabling that backend.
WORKER_MANAGEMENT_SERVICE_URL=
WORKER_MANAGEMENT_GATEWAY_SECRET=
WORKER_MANAGEMENT_SERVICE_CUTOVER_READY=0
STAFFING_SERVICE_URL=
STAFFING_GATEWAY_SECRET=
STAFFING_SERVICE_CUTOVER_READY=0
PROPERTY_MANAGEMENT_SERVICE_URL=
PROPERTY_MANAGEMENT_GATEWAY_SECRET=
PROPERTY_MANAGEMENT_SERVICE_CUTOVER_READY=0
MARKETPLACE_SERVICE_URL=
MARKETPLACE_GATEWAY_SECRET=
MARKETPLACE_SERVICE_CUTOVER_READY=0
# Global BI runs against a separate, read-only analytics database.
# Enable the gateway only after the BI service and approved projection process are ready.
GLOBAL_BI_SERVICE_URL=
GLOBAL_BI_GATEWAY_SECRET=
GLOBAL_BI_SERVICE_CUTOVER_READY=0
# Configure these only in the insurance-ledger service/deployment:
# INSURANCE_DATABASE_URL=postgres://insurance_runtime:...@db:5432/insurance_ledger
# INSURANCE_MIGRATION_DATABASE_URL=postgres://insurance_migrator:...@db:5432/insurance_ledger
# INSURANCE_RUNTIME_DB_ROLE=insurance_runtime
