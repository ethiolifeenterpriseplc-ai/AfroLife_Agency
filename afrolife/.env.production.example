NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://afrolife_app:REPLACE_WITH_RUNTIME_PASSWORD@db.example.com:5432/afrolife?sslmode=verify-full
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
MFA_ENC_KEY=REPLACE_WITH_A_DIFFERENT_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
FILE_STORAGE_DIR=/var/lib/afrolife/private-files
REQUIRE_MFA_FOR_STAFF=1
MFI_PILOT_ENABLED=0
MFI_SERVICE_URL=http://127.0.0.1:3300
MFI_GATEWAY_SECRET=REPLACE_WITH_THE_SAME_UNIQUE_RANDOM_SECRET_AS_MFI_SERVICE
# Change readiness to 1 only after Insurance schema migration, data reconciliation and rollback review.
INSURANCE_SERVICE_URL=
INSURANCE_GATEWAY_SECRET=
INSURANCE_SERVICE_CUTOVER_READY=0
# Leave each readiness flag at 0 until that service's data, contracts, parity,
# backup/restore, and rollback gates have been reviewed and evidenced.
WORKER_MANAGEMENT_SERVICE_URL=
WORKER_MANAGEMENT_GATEWAY_SECRET=
WORKER_MANAGEMENT_SERVICE_CUTOVER_READY=0
STAFFING_SERVICE_URL=
STAFFING_GATEWAY_SECRET=
STAFFING_SERVICE_CUTOVER_READY=0
PROPERTY_MANAGEMENT_SERVICE_URL=
PROPERTY_MANAGEMENT_GATEWAY_SECRET=
PROPERTY_MANAGEMENT_SERVICE_CUTOVER_READY=0
MARKETPLACE_SERVICE_URL=
MARKETPLACE_GATEWAY_SECRET=
MARKETPLACE_SERVICE_CUTOVER_READY=0
SESSION_IDLE_TIMEOUT_MINUTES=30
# Optional comma-separated panel allowlist. Leave empty to show every module.
# This is presentation-level deployment visibility, not an authorization control.
AFROLIFE_ENABLED_MODULES=
CORS_ORIGINS=https://agency.example.com,https://localhost
TRUST_PROXY=1
LOGIN_RATE_LIMIT=20
# Keep the unsafe legacy immediate-activation lease API disabled.
LEGACY_IMMEDIATE_LEASES_ENABLED=0

# Configure only when a payment provider and signed webhook integration are enabled.
# PAYMENT_WEBHOOK_SECRET=

# Configure only for an HTTPS receiver that verifies the request signature.
# NOTIFY_WEBHOOK_URL=
# NOTIFY_WEBHOOK_SECRET=
